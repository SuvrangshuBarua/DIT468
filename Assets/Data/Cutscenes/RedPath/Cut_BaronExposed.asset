    - rid: 5570565921985790136
      type: {class: EventChange_NPCShowLine, ns: , asm: Assembly-CSharp}
      data:
        _message: Thou false vermin. Thou devil himself.
        _knowledge: {fileID: 0}
        _npc: {fileID: 11400000, guid: a8025d70153789843a0b08a06e0a4ac0, type: 2}
        _clearPreviousNpc: {fileID: 0}
    - rid: 5570565921985790137
      type: {class: EventChange_NPCShowLine, ns: , asm: Assembly-CSharp}
      data:
        _message: Innocent Jeanne's life was thrown away for thy gain.
        _knowledge: {fileID: 0}
        _npc: {fileID: 11400000, guid: a8025d70153789843a0b08a06e0a4ac0, type: 2}
        _clearPreviousNpc: {fileID: 0}
    - rid: 5570565921985790138
      type: {class: EventChange_NPCShowLine, ns: , asm: Assembly-CSharp}
      data:
        _message: Head no mind to these accusations. These false words stain my noble
          blood.
        _knowledge: {fileID: 0}
        _npc: {fileID: 11400000, guid: 7a2420cc9b316c34db94f9f33af38e75, type: 2}
        _clearPreviousNpc: {fileID: 11400000, guid: a8025d70153789843a0b08a06e0a4ac0, type: 2}
    - rid: 5570565921985790139
      type: {class: EventChange_NPCShowLine, ns: , asm: Assembly-CSharp}
      data:
        _message: Thy unholy blood shall stain this stage.
        _knowledge: {fileID: 0}
        _npc: {fileID: 11400000, guid: a8025d70153789843a0b08a06e0a4ac0, type: 2}
        _clearPreviousNpc: {fileID: 11400000, guid: 7a2420cc9b316c34db94f9f33af38e75, type: 2}
