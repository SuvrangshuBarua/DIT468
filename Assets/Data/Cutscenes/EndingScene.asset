    - rid: 5570565980918644880
      type: {class: EventChange_SetDialogue, ns: , asm: Assembly-CSharp}
      data: 
    - rid: 5570565980918644881
      type: {class: EventChange_NPCShowLine, ns: , asm: Assembly-CSharp}
      data:
        _message: The pearly gates could not hold me, for my heart remained here.
        _knowledge: {fileID: 0}
        _npc: {fileID: 11400000, guid: ec237e4299038ed4987e0203614d0e93, type: 2}
        _clearPreviousNpc: {fileID: 11400000, guid: 0156e27cc67d6e140891500f53026874, type: 2}
    - rid: 5570565980918644882
      type: {class: EventChange_NPCShowLine, ns: , asm: Assembly-CSharp}
      data:
        _message: O bright angel, beautiful Jeanne, you have returned from the heavens.
        _knowledge: {fileID: 0}
        _npc: {fileID: 11400000, guid: 0156e27cc67d6e140891500f53026874, type: 2}
        _clearPreviousNpc: {fileID: 0}
    - rid: 5570565980918644883
      type: {class: EventChange_NPCShowLine, ns: , asm: Assembly-CSharp}
      data:
        _message: I regret to disturb, but we must make haste if we are to live.
        _knowledge: {fileID: 0}
        _npc: {fileID: 11400000, guid: aa852f52c66bd1149a7a2a704cdaf4df, type: 2}
        _clearPreviousNpc: {fileID: 11400000, guid: 0156e27cc67d6e140891500f53026874, type: 2}
    - rid: 5570565980918644884
      type: {class: EventChange_AddChange, ns: , asm: Assembly-CSharp}
      data:
        _change: {fileID: 11400000, guid: c71170a7df3c65b4182bb60df236a30f, type: 2}
    - rid: 5570565980918644885
      type: {class: EventChange_NPCShowLine, ns: , asm: Assembly-CSharp}
      data:
        _message: In spite of all ill-intents, my wedding shall end happily after
          all.
        _knowledge: {fileID: 0}
        _npc: {fileID: 11400000, guid: 0156e27cc67d6e140891500f53026874, type: 2}
        _clearPreviousNpc: {fileID: 11400000, guid: ec237e4299038ed4987e0203614d0e93, type: 2}
    - rid: 5570565980918644886
      type: {class: EventChange_NPCShowLine, ns: , asm: Assembly-CSharp}
      data:
        _message: Our new faces will allow an escape, if we blend with the chaotic
          crowd above.
        _knowledge: {fileID: 0}
        _npc: {fileID: 11400000, guid: aa852f52c66bd1149a7a2a704cdaf4df, type: 2}
        _clearPreviousNpc: {fileID: 0}
    - rid: 5570565980918644887
      type: {class: EventChange_NPCShowLine, ns: , asm: Assembly-CSharp}
      data:
        _message: 
        _knowledge: {fileID: 0}
        _npc: {fileID: 0}
        _clearPreviousNpc: {fileID: 11400000, guid: aa852f52c66bd1149a7a2a704cdaf4df, type: 2}
    - rid: 5570565980918644888
      type: {class: EventChange_NPCShowLine, ns: , asm: Assembly-CSharp}
      data:
        _message: And so, the scene ends and the curtain falls.
        _knowledge: {fileID: 0}
        _npc: {fileID: 11400000, guid: 6492b215a3d13d540a1f37b41746edcc, type: 2}
        _clearPreviousNpc: {fileID: 0}
    - rid: 5570565980918644889
      type: {class: EventChange_NPCShowLine, ns: , asm: Assembly-CSharp}
      data:
        _message: Mine
        _knowledge: {fileID: 0}
        _npc: {fileID: 11400000, guid: 6492b215a3d13d540a1f37b41746edcc, type: 2}
        _clearPreviousNpc: {fileID: 0}
    - rid: 5570565980918644890
      type: {class: EventChange_NPCShowLine, ns: , asm: Assembly-CSharp}
      data:
        _message: 
        _knowledge: {fileID: 0}
        _npc: {fileID: 0}
        _clearPreviousNpc: {fileID: 11400000, guid: 6492b215a3d13d540a1f37b41746edcc, type: 2}
    - rid: 5570565980918644891
      type: {class: EventChange_NPCShowLine, ns: , asm: Assembly-CSharp}
      data:
        _message: All tragedy reverted and avoided, bar one.
        _knowledge: {fileID: 0}
        _npc: {fileID: 11400000, guid: 6492b215a3d13d540a1f37b41746edcc, type: 2}
        _clearPreviousNpc: {fileID: 0}
