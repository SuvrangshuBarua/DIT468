    - rid: 5570565921985790069
      type: {class: EventChange_NPCShowLine, ns: , asm: Assembly-CSharp}
      data:
        _message: For the good of the family, I accept my fate. I pledge myself to
          you, always and forever.
        _knowledge: {fileID: 0}
        _npc: {fileID: 11400000, guid: 0156e27cc67d6e140891500f53026874, type: 2}
        _clearPreviousNpc: {fileID: 11400000, guid: 2033b28c179a4194fbed273e7ee1134b, type: 2}
    - rid: 5570565921985790070
      type: {class: EventChange_NPCShowLine, ns: , asm: Assembly-CSharp}
      data:
        _message: And you, my child.
        _knowledge: {fileID: 0}
        _npc: {fileID: 11400000, guid: 2033b28c179a4194fbed273e7ee1134b, type: 2}
        _clearPreviousNpc: {fileID: 0}
