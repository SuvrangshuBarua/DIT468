      type: {class: EventChange_NPCShowLine, ns: , asm: Assembly-CSharp}
      data:
        _message: Till the sun sets in the east, I will be by your side
        _knowledge: {fileID: 0}
        _npc: {fileID: 11400000, guid: ff33f8780c9a56d428499a7c3ac7ced2, type: 2}
