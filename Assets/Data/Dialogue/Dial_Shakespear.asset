  _autoPlay: []
  _allOptions:
  - _changesRequired:
      _primingData: []
    _knowledgeRequired: []
    _visualRequired: {fileID: 0}
    _validDuring: []
    _startingLine: '[Ask about the play]'
    _dialogue:
    - _saidByPlayer: 0
      _line: The lie of theatre is twofold today.
    - _saidByPlayer: 0
      _line: A baron of no reputation hogs the centre.
    - _saidByPlayer: 0
      _line: The script itself was warped to caress his feeble greatness.
    _oneTimeOnly: 0
    _onDialogueComplete:
    - rid: 5570565980918644859
  - _changesRequired:
      _primingData: []
    _knowledgeRequired:
    - {fileID: 11400000, guid: a80a85e13aabdae4b91ac40836409e6c, type: 2}
    _visualRequired: {fileID: 0}
    _validDuring:
    - {fileID: 11400000, guid: 7387b4f03ab35fb4399e4c52f3d6aac0, type: 2}
    _startingLine: '[Ask about Jeanne]'
    _dialogue:
    - _saidByPlayer: 0
      _line: A tragedy that extends beyond the stage.
    - _saidByPlayer: 0
      _line: The best actor has perished with no trace, and a worm has taken her
        place.
    - _saidByPlayer: 0
      _line: The count could share more words on the matter.
    _oneTimeOnly: 0
    _onDialogueComplete:
    - rid: 5570565980918644839
