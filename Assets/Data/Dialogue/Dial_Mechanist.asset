  m_Name: Dial_Mechanist
  m_EditorClassIdentifier: 
  _autoPlay: []
  _allOptions:
  - _changesRequired:
      _primingData:
      - _key: {fileID: 11400000, guid: 7352d15310854464e82c9e779c6fcb3a, type: 2}
        _value: 1
      - _key: {fileID: 11400000, guid: 193756dd8d3dcd54999e4edb5cb63539, type: 2}
        _value: 1
    _knowledgeRequired: []
    _visualRequired: {fileID: 0}
    _validDuring:
    - {fileID: 11400000, guid: bfa18cb0c8772e34bad0c190756037d1, type: 2}
    _startingLine: '[Ask him to rig the theatre]'
    _dialogue:
    - _saidByPlayer: 0
      _line: A fine exchange it seems.
    - _saidByPlayer: 0
      _line: A cell is left vacant and a new guest is welcomed in.
    _oneTimeOnly: 0
    _onDialogueComplete:
    - rid: 5570565921985790184
    - rid: 5570565980918644834
  - _changesRequired:
      _primingData:
      - _key: {fileID: 11400000, guid: 7352d15310854464e82c9e779c6fcb3a, type: 2}
        _value: 1
    _knowledgeRequired: []
    _visualRequired: {fileID: 0}
    _validDuring:
    - {fileID: 11400000, guid: bfa18cb0c8772e34bad0c190756037d1, type: 2}
    _startingLine: '[Ask him to rig the wedding]'
    _dialogue:
    - _saidByPlayer: 0
      _line: You had my gratitude already for freeing me.
    - _saidByPlayer: 0
      _line: To gift me such an opportunity is a pleasure I can hardly repay.
    _oneTimeOnly: 0
    _onDialogueComplete:
    - rid: 5570565921985790147
    - rid: 5570565980918644836
  - _changesRequired:
      _primingData: []
    _knowledgeRequired: []
    _visualRequired: {fileID: 0}
    _validDuring: []
    _startingLine: '[Ask why he is in here]'
    _dialogue:
    - _saidByPlayer: 0
      _line: Corruption, crime and conspiracies run deep in this land.
    - _saidByPlayer: 0
      _line: Yet none are punished as harshly as a lowly worker speaking ill of nobility.
    - _saidByPlayer: 0
      _line: I revolted against my wealthy master, who seeked to harm a dear friend.
    _oneTimeOnly: 0
    _onDialogueComplete:
    - rid: 5570565980918644845
  - _changesRequired:
      _primingData: []
    _knowledgeRequired: []
    _visualRequired: {fileID: 0}
    _validDuring:
    - {fileID: 11400000, guid: 7387b4f03ab35fb4399e4c52f3d6aac0, type: 2}
    _startingLine: '[Ask about his strange machine]'
    _dialogue:
    - _saidByPlayer: 0
      _line: 'If you ask such a question, then you are not the intended subject for
        it. '
    - _saidByPlayer: 1
      _line: I am an ally who's aid had been requested.
    - _saidByPlayer: 0
      _line: If so, the machine is one I built out of neccessity.
    - _saidByPlayer: 0
      _line: To save a dear friend from a fatal blow that I designed.
    _oneTimeOnly: 0
    _onDialogueComplete:
    - rid: 5570565980918644835
  - _changesRequired:
      _primingData: []
    _knowledgeRequired:
    - {fileID: 11400000, guid: ea5828edd08db2b4db76dcce88edca6d, type: 2}
    _visualRequired: {fileID: 0}
    _validDuring:
    - {fileID: 11400000, guid: a25a32387ef4d6046972f895e36032c0, type: 2}
    - {fileID: 11400000, guid: bfa18cb0c8772e34bad0c190756037d1, type: 2}
    _startingLine: '[Ask about the automaton]'
    _dialogue:
    - _saidByPlayer: 1
      _line: That metalic killer besides the businessman in blue, is it your doing?
    - _saidByPlayer: 0
      _line: With regret, your theory is true.
    - _saidByPlayer: 0
      _line: The harsh and cunning employer had me construct it.
    - _saidByPlayer: 0
      _line: Only after had I discovered it's true intented purpose.
    _oneTimeOnly: 0
    _onDialogueComplete:
    - rid: 5570565980918644837
