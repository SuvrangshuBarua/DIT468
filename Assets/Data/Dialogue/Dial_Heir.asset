    _startingLine: '[Tell her about the countess]'
    _dialogue:
    - _saidByPlayer: 0
      _line: Oh lord above. Witches roam the earth and I was birth from one.
    - _saidByPlayer: 1
      _line: I regret being the one to share this fresh hearthache.
    - _saidByPlayer: 1
      _line: But I know your character. You know what must be done in time.
    _oneTimeOnly: 0
    _onDialogueComplete:
    - rid: 5570565980918644736
    - rid: 5570565980918644737
  - _changesRequired:
      _primingData: []
    _knowledgeRequired: []
    _visualRequired: {fileID: 11400000, guid: e098030d9e4b0684e9deb3103fa09f63, type: 2}
