    - {fileID: 11400000, guid: bfa18cb0c8772e34bad0c190756037d1, type: 2}
    _startingLine: '[Ask her about Jeanne]'
    _dialogue:
    - _saidByPlayer: 0
      _line: Faithful friend, why do you wound me more when my heart has been ripped
        out.
    - _saidByPlayer: 0
      _line: Skilled Jeanne, beautiful Jeanne.
    - _saidByPlayer: 0
      _line: How I wished to escape this charade of a marriage for her instead.
    _oneTimeOnly: 0
    _onDialogueComplete:
    - rid: 5570565980918644831
