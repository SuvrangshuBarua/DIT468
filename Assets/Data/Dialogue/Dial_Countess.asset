    _startingLine: '[Give the ring to her]'
    _dialogue:
    - _saidByPlayer: 1
      _line: Fair hostess, please accept this humble gift.
    - _saidByPlayer: 0
      _line: Such a kind and gracious gesture must be welcomed warmly.
    _oneTimeOnly: 0
    _onDialogueComplete:
    - rid: 5570565921985790120
  - _changesRequired:
      _primingData: []
    _knowledgeRequired: []
    _visualRequired: {fileID: 11400000, guid: 7a2420cc9b316c34db94f9f33af38e75, type: 2}
    _validDuring: []
    _startingLine: '[Greet her as the Baron]'
    _dialogue:
    - _saidByPlayer: 0
      _line: The false baron appears.
    - _saidByPlayer: 0
      _line: Go flaunt your newfound nobility on the stage, tool
    - _saidByPlayer: 0
      _line: and hide the bloody trail of your true profession.
    _oneTimeOnly: 0
    _onDialogueComplete:
    - rid: 5570565980918644846
    - rid: 5570565980918644847
  - _changesRequired:
      _primingData: []
    _knowledgeRequired: []
    _visualRequired: {fileID: 0}
    _validDuring: []
    _startingLine: '[Ask her about Jeanne]'
    _dialogue:
    - _saidByPlayer: 0
      _line: I know not much of her.
    - _saidByPlayer: 0
      _line: Speak to my husband if you appreciate theatrics.
    - _saidByPlayer: 0
      _line: Or lower thyself to our kitchen and roam where she stayed.
    _oneTimeOnly: 0
    _onDialogueComplete: []
